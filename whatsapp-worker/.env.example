# Copie para ".env" e preencha.

# Mesmo banco de dados Postgres usado pelo painel principal (Settings do projeto
# na Vercel → Environment Variables → DATABASE_URL).
DATABASE_URL=""

# Segredo compartilhado com o painel principal (variável WHATSAPP_WORKER_SECRET
# lá no projeto da Vercel). Qualquer string longa e aleatória, só precisa ser
# igual nos dois lados.
WORKER_SECRET=""

# Pasta onde a sessão do WhatsApp fica salva. No Railway, aponte para dentro de
# um Volume (ex: /data/auth) para a sessão sobreviver a reinicializações.
AUTH_DIR="./auth_info_baileys"

PORT=3001
