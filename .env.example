# Copie este arquivo para ".env" e preencha com os seus valores.

# Banco de dados Postgres. Localmente, aponte para um Postgres instalado na sua
# máquina; em produção, use a URL do banco hospedado (ex: Neon, via Vercel).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mercadolivre_manager"

# Segredo usado para assinar o cookie de sessão do painel. Troque por um valor aleatório longo.
SESSION_SECRET="troque-este-valor-por-uma-string-aleatoria-bem-grande-e-secreta"

# Credenciais do aplicativo criado em https://developers.mercadolivre.com.br
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
# URL completa cadastrada como "redirect_uri" no aplicativo do Mercado Livre
ML_REDIRECT_URI="http://localhost:3000/api/ml/oauth/callback"

# URL base do site (usada para montar links). Em produção, use o domínio real.
APP_URL="http://localhost:3000"

# Serviço (worker) do WhatsApp — veja a pasta whatsapp-worker/. Em produção,
# use a URL pública do serviço hospedado (ex: Railway) e o mesmo segredo
# configurado na variável WORKER_SECRET do worker.
WHATSAPP_WORKER_URL="http://localhost:3001"
WHATSAPP_WORKER_SECRET=""

# Armazenamento de fotos/imagens/áudios/documentos trocados no WhatsApp
# (Vercel Blob — Storage no painel da Vercel). O mesmo valor também precisa
# estar configurado no worker (whatsapp-worker/.env), pois ele sobe as
# mídias recebidas direto de lá.
BLOB_READ_WRITE_TOKEN=""
