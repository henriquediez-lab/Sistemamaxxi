// Schema do banco de dados do Gestor de Conta Mercado Livre
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Usuário que acessa o painel (login do sistema, não é a conta do Mercado Livre)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Conta do Mercado Livre conectada via OAuth2
model MlAccount {
  id           String   @id @default(cuid())
  sellerId     String   @unique // "user_id" retornado pelo Mercado Livre
  nickname     String?
  siteId       String   @default("MLB") // MLB = Brasil
  accessToken  String
  refreshToken String
  tokenType    String   @default("bearer")
  scope        String?
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Marca quando o histórico inicial de pedidos (últimos ~12 meses) foi
  // completamente sincronizado, para as próximas sincronizações saberem
  // que podem buscar só pedidos novos em vez de tudo de novo.
  pedidosHistoricoCompletoEm DateTime?
  // Ponto onde a busca do histórico inicial parou (caso não tenha dado
  // tempo de terminar numa única sincronização), para continuar dali na
  // próxima em vez de recomeçar do zero.
  pedidosSyncCursor          DateTime?

  anuncios Anuncio[]
  pedidos  Pedido[]
  syncLogs SyncLog[]
}

// Registro de cada sincronização (anúncios ou pedidos), para o usuário acompanhar o progresso
model SyncLog {
  id           String    @id @default(cuid())
  mlAccountId  String
  mlAccount    MlAccount @relation(fields: [mlAccountId], references: [id], onDelete: Cascade)
  type         String    @default("anuncios") // anuncios | pedidos
  status       String    @default("em_andamento") // em_andamento | concluido | erro
  itemsSynced  Int       @default(0)
  itemsTotal   Int?
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([mlAccountId, type])
}

// Anúncio (item) do Mercado Livre
model Anuncio {
  id                String    @id // ML item id, ex: MLB123456789
  mlAccountId       String
  mlAccount         MlAccount @relation(fields: [mlAccountId], references: [id], onDelete: Cascade)
  title             String
  permalink         String?
  thumbnail         String?
  price             Float
  currencyId        String    @default("BRL")
  availableQuantity Int       @default(0)
  soldQuantity      Int       @default(0)
  status            String // active | paused | closed | under_review | ...
  condition         String?
  listingTypeId     String?
  categoryId        String?
  catalogListing    Boolean   @default(false)
  healthScore       Float? // "item health" retornado pelo Mercado Livre, quando disponível
  mlDateCreated     DateTime?
  mlLastUpdated     DateTime?
  lastSyncedAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([mlAccountId])
  @@index([status])
}

// Pedido (venda) do Mercado Livre
model Pedido {
  id            String    @id // ML order id
  mlAccountId   String
  mlAccount     MlAccount @relation(fields: [mlAccountId], references: [id], onDelete: Cascade)
  status        String // paid | confirmed | payment_required | cancelled | invalid | ...
  statusDetail  String?
  totalAmount   Float
  paidAmount    Float?
  currencyId    String    @default("BRL")
  buyerNickname String?
  mlDateCreated DateTime
  mlDateClosed  DateTime?
  lastSyncedAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  itens PedidoItem[]

  @@index([mlAccountId])
  @@index([status])
  @@index([mlDateCreated])
}

// Item de um pedido (um pedido pode ter vários produtos)
model PedidoItem {
  id        String  @id @default(cuid())
  pedidoId  String
  pedido    Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  itemId    String? // ML item id do anúncio vendido, quando disponível
  title     String
  quantity  Int
  unitPrice Float

  @@index([pedidoId])
}

// Conversa de WhatsApp com um contato (cliente)
model WhatsappContato {
  id                     String    @id @default(cuid())
  telefone               String    @unique // identificador do WhatsApp (número ou JID completo, ex: 5511999999999@s.whatsapp.net)
  nome                   String?
  fotoUrl                String? // foto de perfil do WhatsApp (atualizada quando chega mensagem nova)
  setor                  String? // rótulo livre (financeiro, suporte, vendas...), definido manualmente ou por automação
  naoLida                Boolean   @default(false) // tem mensagem de entrada ainda não vista pela equipe
  arquivada              Boolean   @default(false)
  // true logo depois de mandar a saudação com o menu de setores, enquanto
  // aguarda o cliente responder com o número da opção escolhida
  aguardandoEscolhaSetor Boolean   @default(false)
  ultimaMensagemEm       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  mensagens WhatsappMensagem[]
  etiquetas WhatsappContatoEtiqueta[]

  @@index([ultimaMensagemEm])
}

// Mensagem trocada com um contato (recebida ou enviada)
model WhatsappMensagem {
  id               String             @id @default(cuid())
  contatoId        String
  contato          WhatsappContato    @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  direcao          String // entrada | saida
  waMessageId      String? // id da mensagem no próprio WhatsApp (usado para responder citando)
  tipo             String             @default("texto") // texto | imagem | video | audio | documento
  texto            String? // texto da mensagem, ou legenda quando for mídia
  midiaUrl         String? // URL do arquivo (Vercel Blob), quando tipo != texto
  midiaMimetype    String?
  midiaNomeArquivo String? // nome original, principalmente para documentos
  respondendoAId   String?
  respondendoA     WhatsappMensagem?  @relation("RespostaCitada", fields: [respondendoAId], references: [id], onDelete: SetNull)
  respostas        WhatsappMensagem[] @relation("RespostaCitada")
  automatica       Boolean            @default(false) // true quando foi uma resposta automática (regra de palavra-chave)
  enviadoPor       String? // e-mail de quem respondeu manualmente, quando aplicável
  erro             String? // mensagem de erro, se falhou ao enviar
  createdAt        DateTime           @default(now())

  @@index([contatoId, createdAt])
  @@index([waMessageId])
}

// Regra de resposta automática por palavra-chave (primeiro atendimento / triagem)
model WhatsappRegraAutomatica {
  id           String   @id @default(cuid())
  palavraChave String // texto buscado na mensagem recebida (sem acento, minúsculo)
  resposta     String
  setor        String? // se definido, marca o contato com esse setor ao disparar
  ativo        Boolean  @default(true)
  ordem        Int      @default(0) // regras com ordem menor são testadas primeiro
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Configuração única da saudação automática (singleton, id sempre "default")
model WhatsappSaudacaoConfig {
  id        String   @id @default("default")
  ativo     Boolean  @default(true)
  mensagem  String   @default("Olá! 👋 Bem-vindo(a). Pra agilizar o atendimento, escolha uma opção:")
  updatedAt DateTime @updatedAt
}

// Opção de setor mostrada no menu da saudação automática (ex: "1 - Vendas")
model WhatsappSetorOpcao {
  id        String   @id @default(cuid())
  numero    Int      @unique
  nome      String
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Etiqueta livre pra organizar conversas por assunto (ex: "Urgente", "Aguardando pagamento")
model WhatsappEtiqueta {
  id        String                    @id @default(cuid())
  nome      String                    @unique
  cor       String                    @default("#25D366")
  createdAt DateTime                  @default(now())
  contatos  WhatsappContatoEtiqueta[]
}

// Relação N:N entre contato e etiqueta
model WhatsappContatoEtiqueta {
  contatoId  String
  contato    WhatsappContato  @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  etiquetaId String
  etiqueta   WhatsappEtiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@id([contatoId, etiquetaId])
}

// Resposta pronta que o atendente insere digitando "/atalho" na caixa de texto
model WhatsappRespostaRapida {
  id        String   @id @default(cuid())
  atalho    String   @unique // sem a barra, ex: "horario"
  texto     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
